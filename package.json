{
  "name": "pe-learning-path",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0 <23.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "docs": "npm run dev --workspace @pe-learning-path/docs",
    "cdk:diff": "npm run diff --workspace @pe-learning-path/cdk-playground",
    "cdk:deploy": "npm run deploy --workspace @pe-learning-path/cdk-playground",
    "synth": "cdk synth",
    "deploy": "cdk deploy"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
